{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feynagent.local/schemas/physics_card.schema.json",
  "title": "PhysicsCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "status",
    "process_id",
    "model_id",
    "sector",
    "process_type",
    "perturbative_order",
    "particles",
    "requested_outputs",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "object_id": {
      "$ref": "#/$defs/object_id"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "process_id": {
      "$ref": "#/$defs/external_object_id"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_./:-]*$"
    },
    "sector": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_./:-]*$"
    },
    "process_type": {
      "type": "string",
      "enum": [
        "decay_1_to_n",
        "scattering_2_to_2",
        "scattering_2_to_3"
      ]
    },
    "perturbative_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_order",
        "restriction"
      ],
      "properties": {
        "loop_order": {
          "type": "integer",
          "const": 0
        },
        "restriction": {
          "type": "string",
          "const": "tree_level_only"
        }
      }
    },
    "coupling_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "named_assumption"
          ]
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coupling_power"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "named_assumption": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "orders"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            }
          },
          "not": {
            "required": [
              "named_assumption"
            ]
          }
        },
        {
          "required": [
            "named_assumption"
          ],
          "properties": {
            "mode": {
              "const": "named_assumption"
            }
          },
          "not": {
            "required": [
              "orders"
            ]
          }
        }
      ]
    },
    "particles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incoming",
        "outgoing"
      ],
      "properties": {
        "incoming": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/process_particle"
          },
          "minItems": 1
        },
        "outgoing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/process_particle"
          },
          "minItems": 1
        }
      }
    },
    "internal_species_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_particle_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/particle_id"
          },
          "uniqueItems": true
        },
        "forbidden_particle_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/particle_id"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "required": [
            "allowed_particle_ids"
          ]
        },
        {
          "required": [
            "forbidden_particle_ids"
          ]
        }
      ]
    },
    "requested_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "diagram_ir",
          "tikz_feynman",
          "latex_amplitude",
          "feyncalc_code",
          "validation_report"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "amplitude_generation",
        "heavy_calculation"
      ],
      "properties": {
        "topology": {
          "$ref": "#/$defs/approval_gate"
        },
        "amplitude_generation": {
          "$ref": "#/$defs/approval_gate"
        },
        "heavy_calculation": {
          "$ref": "#/$defs/approval_gate"
        }
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "particle_latex_labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/particle_latex_label"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "process_type": {"const": "scattering_2_to_2"}
        }
      },
      "then": {
        "properties": {
          "particles": {
            "properties": {
              "incoming": {"minItems": 2, "maxItems": 2},
              "outgoing": {"minItems": 2, "maxItems": 2}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "process_type": {"const": "scattering_2_to_3"}
        }
      },
      "then": {
        "properties": {
          "particles": {
            "properties": {
              "incoming": {"minItems": 2, "maxItems": 2},
              "outgoing": {"minItems": 3, "maxItems": 3}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_./:-]*$"
    },
    "external_object_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./:-]*$"
    },
    "particle_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./:+-]*$"
    },
    "process_particle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "particle_id",
        "state_role",
        "momentum_label"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 1
        },
        "particle_id": {
          "$ref": "#/$defs/particle_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "state_role": {
          "type": "string",
          "enum": [
            "incoming",
            "outgoing"
          ]
        },
        "momentum_label": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "latex_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coupling_power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coupling",
        "power"
      ],
      "properties": {
        "coupling": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "power": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected",
            "blocked"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "particle_latex_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particle_id",
        "latex_label"
      ],
      "properties": {
        "particle_id": {
          "$ref": "#/$defs/particle_id"
        },
        "latex_label": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
